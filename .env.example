# ============================================================
# RUNTIME
# ============================================================

NODE_ENV=development
PORT=4000

# Em produção, CORS_ORIGINS é obrigatório.
# Múltiplas origens podem ser separadas por vírgula.
CORS_ORIGINS=http://localhost:3000

# Desenvolvimento: true
# Produção: false por padrão
SWAGGER_ENABLED=true


# ============================================================
# DATABASE
# ============================================================

DATABASE_URL=postgresql://vera:vera_dev@localhost:5433/vera


# ============================================================
# PUBLIC APP
# ============================================================

# URL pública do frontend Vera utilizada, entre outras coisas,
# para gerar links de verificação associados ao QR.
VERA_PUBLIC_APP_URL=http://localhost:3000


# ============================================================
# AUTH
# ============================================================

# Mínimo de 32 caracteres.
# Em produção deve ser gerado aleatoriamente.
AUTH_ACCESS_TOKEN_SECRET=change-me-with-at-least-32-random-characters

# Default no código: 900
AUTH_ACCESS_TOKEN_TTL_SECONDS=900

# Default no código: 30
AUTH_REFRESH_TOKEN_TTL_DAYS=30


# ============================================================
# VERA SIGNING
# ============================================================

# Identificador da chave Ed25519 ativa.
VERA_SIGNING_KEY_ID=vera-dev-2026-01

# Caminhos relativos à raiz do projeto/processo.
# Estes ficheiros NÃO devem ser versionados.
VERA_SIGNING_PRIVATE_KEY_PATH=keys/private/vera-dev-2026-01.pem
VERA_SIGNING_PUBLIC_KEYS_DIR=keys/public


# ============================================================
# S3-COMPATIBLE STORAGE
# ============================================================

S3_ENDPOINT=http://localhost:59000
S3_REGION=us-east-1
S3_ACCESS_KEY=vera
S3_SECRET_KEY=vera_dev_storage_secret
S3_BUCKET=vera-documents

# SeaweedFS local normalmente usa true.
# Para o provedor de produção, ajustar conforme necessário.
S3_FORCE_PATH_STYLE=true

# Desenvolvimento:
# pode criar automaticamente o bucket.
#
# Produção:
# deve normalmente ser false e o bucket deve ser
# provisionado antes do arranque da API.
S3_CREATE_BUCKET_IF_MISSING=true


# ============================================================
# DEVELOPMENT / SEED ONLY
# ============================================================

# Não são necessários para executar a API em produção
# depois de as contas terem sido provisionadas.

SEED_PLATFORM_ADMIN_EMAIL=admin@example.com
SEED_PLATFORM_ADMIN_NAME=Platform Admin
SEED_PLATFORM_ADMIN_PASSWORD=change-me