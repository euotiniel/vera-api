generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/**
 * ============================================================
 * AUTH
 * ============================================================
 */

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum SystemRole {
  USER
  PLATFORM_ADMIN
}

/**
 * ============================================================
 * ORGANIZATIONS
 * ============================================================
 */

enum OrganizationRole {
  CREATOR
  REVIEWER
  APPROVER
}

/**
 * ============================================================
 * DOCUMENT SUBMISSIONS
 * ============================================================
 */

enum DocumentSubmissionStatus {
  DRAFT
  PENDING_REVIEW
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CANCELLED
}

enum DocumentSubmissionStage {
  REVIEW
  APPROVAL
}

enum DocumentSubmissionDecisionOutcome {
  APPROVED
  REJECTED
}

enum DocumentSubmissionKind {
  NEW_DOCUMENT
  NEW_VERSION
}

/**
 * ============================================================
 * DOCUMENTS
 * ============================================================
 */

enum DocumentStatus {
  PENDING
  VALID
  REVOKED
  REPLACED
  EXPIRED
}

enum DocumentLifecycleEventType {
  REGISTERED
  STATUS_CHANGED
}

enum OriginalFileAccess {
  PUBLIC
  RESTRICTED
  PRIVATE
}

/**
 * ============================================================
 * USERS
 * ============================================================
 */

model User {
  id String @id @default(cuid())

  email String @unique
  name  String

  passwordHash String

  status     UserStatus @default(ACTIVE)
  systemRole SystemRole @default(USER)

  emailVerifiedAt DateTime?

  sessions    Session[]
  memberships OrganizationMember[]

  createdSubmissions  DocumentSubmission[]         @relation("SubmissionCreator")
  submissionDecisions DocumentSubmissionDecision[] @relation("SubmissionDecisionActor")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([systemRole])
}

model Session {
  id String @id

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  refreshTokenHash String @unique

  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

/**
 * ============================================================
 * ORGANIZATIONS
 * ============================================================
 */

model Organization {
  id       String  @id @default(cuid())
  name     String
  slug     String  @unique
  verified Boolean @default(false)

  documents   Document[]
  memberships OrganizationMember[]
  submissions DocumentSubmission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrganizationMember {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  role OrganizationRole

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@index([role])
}

/**
 * ============================================================
 * DOCUMENT SUBMISSIONS
 * ============================================================
 */

model DocumentSubmission {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  creatorId String
  creator   User   @relation("SubmissionCreator", fields: [creatorId], references: [id])

  kind DocumentSubmissionKind @default(NEW_DOCUMENT)

  /**
   * Para NEW_VERSION:
   * targetDocument = documento lógico que
   * receberá a nova versão.
   * baseVersion = versão corrente observada
   * quando a submissão foi criada.
   */
  targetDocumentId String?
  targetDocument   Document? @relation("SubmissionTargetDocument", fields: [targetDocumentId], references: [id], onDelete: SetNull)

  baseVersion Int?

  title     String
  type      String?
  reference String?
  issuedAt  DateTime?

  originalFileAccess OriginalFileAccess @default(PUBLIC)

  /**
   * Ficheiro submetido para revisão.
   * Este ficheiro ainda NÃO representa
   * uma versão oficial da Vera.
   */
  filename   String
  mimeType   String
  size       Int
  sha256     String
  storageKey String @unique

  status DocumentSubmissionStatus @default(DRAFT)

  /**
   * Momento em que o CREATOR envia
   * efetivamente o draft para REVIEWER.
   */
  submittedAt DateTime?

  /**
   * Para NEW_DOCUMENT:
   * aponta para o Document criado por
   * esta submissão.
   * Continua @unique porque apenas uma
   * submissão origina a identidade lógica
   * inicial de cada Document.
   */
  documentId String?   @unique
  document   Document? @relation("SubmissionDocument", fields: [documentId], references: [id], onDelete: SetNull)

  /**
   * Versão exata produzida pela submissão.
   * Aplica-se tanto a NEW_DOCUMENT/v1
   * como a NEW_VERSION/v2+.
   */
  issuedVersionId String?          @unique
  issuedVersion   DocumentVersion? @relation("SubmissionIssuedVersion", fields: [issuedVersionId], references: [id], onDelete: SetNull)

  decisions DocumentSubmissionDecision[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([creatorId])
  @@index([status])
  @@index([sha256])
  @@index([organizationId, status])
  @@index([targetDocumentId])
  @@index([kind, status])
}

model DocumentSubmissionDecision {
  id String @id @default(cuid())

  submissionId String
  submission   DocumentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  actorId String
  actor   User   @relation("SubmissionDecisionActor", fields: [actorId], references: [id])

  stage DocumentSubmissionStage

  decision DocumentSubmissionDecisionOutcome

  reason String?

  createdAt DateTime @default(now())

  @@unique([submissionId, stage])
  @@index([submissionId])
  @@index([actorId])
  @@index([stage])
  @@index([decision])
}

/**
 * ============================================================
 * DOCUMENTS
 * ============================================================
 */

model Document {
  id        String         @id @default(cuid())
  publicId  String         @unique
  title     String
  type      String?
  reference String?
  status    DocumentStatus @default(VALID)
  issuedAt  DateTime?

  originalFileAccess OriginalFileAccess @default(PUBLIC)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  versions        DocumentVersion[]
  lifecycleEvents DocumentLifecycleEvent[]

  /**
   * Documento sucessor.
   * A → B significa:
   * A.replacedById = B.id
   * A e B continuam a ser Documents
   * distintos, com Public IDs distintos.
   * Isto NÃO representa v1 → v2.
   */
  replacedById String?
  replacedBy   Document?  @relation("DocumentReplacement", fields: [replacedById], references: [id], onDelete: Restrict)
  replaces     Document[] @relation("DocumentReplacement")

  /**
   * Submissão interna que originou
   * este documento.
   */
  sourceSubmission DocumentSubmission? @relation("SubmissionDocument")

  /**
   * Submissões posteriores que produziram
   * novas versões deste mesmo documento.
   */
  versionSubmissions DocumentSubmission[] @relation("SubmissionTargetDocument")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([replacedById])
}

model DocumentVersion {
  id       String @id @default(cuid())
  version  Int
  filename String
  mimeType String
  size     Int
  sha256   String @unique

  storageKey String? @unique

  qrProof String? @unique

  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  attestation Attestation?

  /**
   * Submissão que produziu exatamente
   * esta versão.
   */
  issuedBySubmission DocumentSubmission? @relation("SubmissionIssuedVersion")

  createdAt DateTime @default(now())

  @@unique([documentId, version])
  @@index([sha256])
}

model Attestation {
  id String @id @default(cuid())

  documentVersionId String          @unique
  documentVersion   DocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)

  payload   String
  signature String
  algorithm String
  keyId     String

  createdAt DateTime @default(now())

  @@index([keyId])
}

model DocumentLifecycleEvent {
  id String @id @default(cuid())

  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  sequence Int

  type DocumentLifecycleEventType

  fromStatus DocumentStatus?
  toStatus   DocumentStatus

  reason String?

  previousEventHash String?

  payload   String
  signature String
  algorithm String
  keyId     String

  eventHash String @unique

  createdAt DateTime @default(now())

  @@unique([documentId, sequence])
  @@index([documentId, createdAt])
  @@index([previousEventHash])
}

/**
 * ============================================================
 * VERIFICATION ANALYTICS
 * ============================================================
 */

model VerificationEvent {
  id String @id @default(cuid())

  hash       String
  matched    Boolean
  documentId String?

  createdAt DateTime @default(now())

  @@index([hash])
  @@index([documentId])
}

/**
 * ============================================================
 * VERIFICATION AUDIT
 * ============================================================
 */

model VerificationAuditEvent {
  id String @id @default(cuid())

  /**
   * PUBLIC_ID | FILE | QR
   */
  method String

  /**
   * Política que produziu o verdict.
   */
  policy String

  /**
   * Resultado materializado naquele momento.
   */
  verdictCode String
  verified    Boolean

  publicId   String?
  documentId String?

  /**
   * Apenas relevante para FILE.
   */
  hash    String?
  matched Boolean?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([method, createdAt])
  @@index([verdictCode, createdAt])
  @@index([verified, createdAt])
  @@index([publicId, createdAt])
  @@index([documentId, createdAt])
}
