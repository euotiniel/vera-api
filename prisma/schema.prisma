generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/**
 * ============================================================
 * AUTH
 * ============================================================
 */

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum SystemRole {
  USER
  PLATFORM_ADMIN
}

/**
 * ============================================================
 * ORGANIZATIONS
 * ============================================================
 */

enum OrganizationRole {
  CREATOR
  REVIEWER
  APPROVER
}

/**
 * ============================================================
 * DOCUMENT SUBMISSIONS
 * ============================================================
 */

enum DocumentSubmissionStatus {
  DRAFT
  PENDING_REVIEW
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CANCELLED
}

enum DocumentSubmissionStage {
  REVIEW
  APPROVAL
}

enum DocumentSubmissionDecisionOutcome {
  APPROVED
  REJECTED
}

enum DocumentSubmissionKind {
  NEW_DOCUMENT
  NEW_VERSION
}

/**
 * ============================================================
 * DOCUMENTS
 * ============================================================
 */

enum DocumentStatus {
  PENDING
  VALID
  REVOKED
  REPLACED
  EXPIRED
}

enum DocumentLifecycleEventType {
  REGISTERED
  STATUS_CHANGED
}

enum OriginalFileAccess {
  PUBLIC
  RESTRICTED
  PRIVATE
}

/**
 * ============================================================
 * USERS
 * ============================================================
 */

model User {
  id String @id @default(cuid())

  email String @unique
  name  String

  passwordHash String

  status     UserStatus @default(ACTIVE)
  systemRole SystemRole @default(USER)

  emailVerifiedAt DateTime?

  sessions    Session[]
  memberships OrganizationMember[]

  createdSubmissions  DocumentSubmission[]         @relation("SubmissionCreator")
  submissionDecisions DocumentSubmissionDecision[] @relation("SubmissionDecisionActor")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([systemRole])
}

model Session {
  id String @id

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  refreshTokenHash String @unique

  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

/**
 * ============================================================
 * ORGANIZATIONS
 * ============================================================
 */

model Organization {
  id       String  @id @default(cuid())
  name     String
  slug     String  @unique
  verified Boolean @default(false)

  documents   Document[]
  memberships OrganizationMember[]
  submissions DocumentSubmission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrganizationMember {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  role OrganizationRole

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@index([role])
}

/**
 * ============================================================
 * DOCUMENT SUBMISSIONS
 * ============================================================
 */

model DocumentSubmission {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  creatorId String
  creator   User   @relation("SubmissionCreator", fields: [creatorId], references: [id])

  /**
   * NEW_DOCUMENT = emissão inicial de um novo
   * documento Vera.
   * NEW_VERSION = nova versão de um Document
   * Vera já existente.
   */
  kind DocumentSubmissionKind @default(NEW_DOCUMENT)

  /**
   * Apenas NEW_VERSION.
   * Documento lógico ao qual a nova versão
   * será adicionada.
   */
  targetDocumentId String?
  targetDocument   Document? @relation("SubmissionTargetDocument", fields: [targetDocumentId], references: [id], onDelete: SetNull)

  /**
   * Apenas NEW_VERSION.
   * Número da versão atual no momento em que
   * a submissão foi criada.
   * Funciona como controlo otimista para
   * impedir emissão sobre uma base que já
   * deixou de ser a versão atual.
   */
  baseVersion Int?

  title     String
  type      String?
  reference String?
  issuedAt  DateTime?

  originalFileAccess OriginalFileAccess @default(PUBLIC)

  /**
   * Ficheiro submetido para revisão.
   * Este ficheiro ainda NÃO representa
   * um DocumentVersion oficial da Vera.
   */
  filename   String
  mimeType   String
  size       Int
  sha256     String
  storageKey String @unique

  status DocumentSubmissionStatus @default(DRAFT)

  /**
   * Momento em que o CREATOR efetivamente
   * envia o draft para REVIEWER.
   */
  submittedAt DateTime?

  /**
   * Apenas a submissão NEW_DOCUMENT que
   * originou o Document.
   * Mantido para compatibilidade e para
   * preservar a proveniência da emissão
   * inicial.
   */
  documentId String?   @unique
  document   Document? @relation("SubmissionDocument", fields: [documentId], references: [id], onDelete: SetNull)

  /**
   * Versão oficial efetivamente produzida
   * por esta submissão.
   * Pode apontar para v1, v2, v3...
   */
  issuedVersionId String?          @unique
  issuedVersion   DocumentVersion? @relation("SubmissionIssuedVersion", fields: [issuedVersionId], references: [id], onDelete: SetNull)

  decisions DocumentSubmissionDecision[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([creatorId])
  @@index([status])
  @@index([sha256])
  @@index([organizationId, status])
  @@index([targetDocumentId])
  @@index([kind, status])
}

model DocumentSubmissionDecision {
  id String @id @default(cuid())

  submissionId String
  submission   DocumentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  actorId String
  actor   User   @relation("SubmissionDecisionActor", fields: [actorId], references: [id])

  /**
   * REVIEW   = decisão do REVIEWER
   * APPROVAL = decisão do APPROVER
   */
  stage DocumentSubmissionStage

  decision DocumentSubmissionDecisionOutcome

  reason String?

  createdAt DateTime @default(now())

  /**
   * Cada etapa só pode produzir
   * uma decisão final.
   */
  @@unique([submissionId, stage])
  @@index([submissionId])
  @@index([actorId])
  @@index([stage])
  @@index([decision])
}

/**
 * ============================================================
 * DOCUMENTS
 * ============================================================
 */

model Document {
  id        String         @id @default(cuid())
  publicId  String         @unique
  title     String
  type      String?
  reference String?
  status    DocumentStatus @default(VALID)
  issuedAt  DateTime?

  originalFileAccess OriginalFileAccess @default(PUBLIC)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  versions        DocumentVersion[]
  lifecycleEvents DocumentLifecycleEvent[]

  /**
   * Submissão interna que originou
   * este documento.
   * null mantém compatibilidade com
   * documentos legacy já existentes.
   */
  sourceSubmission DocumentSubmission? @relation("SubmissionDocument")

  /**
   * Submissões criadas posteriormente
   * para produzir novas versões deste
   * mesmo documento lógico.
   */
  versionSubmissions DocumentSubmission[] @relation("SubmissionTargetDocument")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}

model DocumentVersion {
  id       String @id @default(cuid())
  version  Int
  filename String
  mimeType String
  size     Int
  sha256   String @unique

  storageKey String? @unique

  /**
   * QR Proof canónico emitido pela Vera
   * para esta versão.
   * null mantém compatibilidade com
   * documentos legacy.
   */
  qrProof String? @unique

  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  attestation Attestation?

  /**
   * Submissão que produziu esta versão.
   * null mantém compatibilidade com
   * versões emitidas antes deste modelo.
   */
  issuedBySubmission DocumentSubmission? @relation("SubmissionIssuedVersion")

  createdAt DateTime @default(now())

  @@unique([documentId, version])
  @@index([sha256])
}

model Attestation {
  id String @id @default(cuid())

  documentVersionId String          @unique
  documentVersion   DocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)

  payload   String
  signature String
  algorithm String
  keyId     String

  createdAt DateTime @default(now())

  @@index([keyId])
}

model DocumentLifecycleEvent {
  id String @id @default(cuid())

  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  sequence Int

  type DocumentLifecycleEventType

  fromStatus DocumentStatus?
  toStatus   DocumentStatus

  reason String?

  previousEventHash String?

  payload   String
  signature String
  algorithm String
  keyId     String

  eventHash String @unique

  createdAt DateTime @default(now())

  @@unique([documentId, sequence])
  @@index([documentId, createdAt])
  @@index([previousEventHash])
}

/**
 * ============================================================
 * VERIFICATION ANALYTICS
 * ============================================================
 */

model VerificationEvent {
  id String @id @default(cuid())

  hash       String
  matched    Boolean
  documentId String?

  createdAt DateTime @default(now())

  @@index([hash])
  @@index([documentId])
}

/**
 * ============================================================
 * VERIFICATION AUDIT
 * ============================================================
 */

model VerificationAuditEvent {
  id String @id @default(cuid())

  /**
   * PUBLIC_ID | FILE | QR
   */
  method String

  /**
   * Política que produziu o verdict.
   * Ex.: vera.public-verification.v4
   */
  policy String

  /**
   * Resultado materializado naquele momento.
   * Ex.: VERIFIED, REVOKED, NOT_FOUND.
   */
  verdictCode String
  verified    Boolean

  /**
   * Identificadores conhecidos no momento
   * da verificação.
   */
  publicId   String?
  documentId String?

  /**
   * Apenas relevante para FILE.
   */
  hash    String?
  matched Boolean?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([method, createdAt])
  @@index([verdictCode, createdAt])
  @@index([verified, createdAt])
  @@index([publicId, createdAt])
  @@index([documentId, createdAt])
}
